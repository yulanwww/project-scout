# Copy this file to .env. Never put passwords, access tokens, or private notes here.

# SQLite database location; relative paths resolve from the project directory.
PROJECT_SCOUT_DB_PATH=tools.db

# Optional GitHub Markdown library settings. Change the owner/repository placeholder.
PROJECT_SCOUT_REPOSITORY=owner/private-library
PROJECT_SCOUT_BRANCH=main
PROJECT_SCOUT_VAULT_PATH=Vault
PROJECT_SCOUT_STATE_DIR=.local

# Optional absolute path overrides when tools are not available through PATH.
# PROJECT_SCOUT_GIT_EXECUTABLE=
# OBSIDIAN_EXECUTABLE=
