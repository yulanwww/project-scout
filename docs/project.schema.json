{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "category",
    "url",
    "usefulness",
    "examples",
    "limitations",
    "recommendation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "github_url": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "pricing": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "usefulness": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "github",
        "website",
        "diy"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 30
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3,
      "maxItems": 4
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "maxItems": 3
    },
    "references": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}
